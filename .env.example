# FêteFlow AI Server Environment Configuration
PORT=3001

# Google Gemini API Key
# Optional during development (system gracefully uses smart local fallback planner if unset)
# Set your key below or add it via the in-app Settings panel
GEMINI_API_KEY=

# Supported models: gemini-2.5-flash (recommended), gemini-1.5-flash, gemini-1.5-pro
GEMINI_MODEL=gemini-2.5-flash
