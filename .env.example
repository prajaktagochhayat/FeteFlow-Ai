# =======================================================
# FÊTEFLOW AI - Environment Configuration
# =======================================================

# Port for local backend (optional if running node server)
PORT=3001

# Google Gemini GenAI Configuration
# Set your Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=
VITE_GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# =======================================================
# Supabase Database & Auth Configuration
# =======================================================
# Create a free project at https://supabase.com/
# Copy the Project URL and anon public key from Project Settings -> API
# If left empty, FêteFlow operates in Zero-Setup Local Multi-User Mode!
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
